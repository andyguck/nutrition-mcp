{
  "name": "myfood-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "overrides": {
    "undici": "7.30.1",
    "@cloudflare/vitest-plugin": { "zod": "$zod" }
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types && npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run check && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
